<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Site Visit List View -->
    <record id="view_crm_site_visit_tree" model="ir.ui.view">
        <field name="name">crm.site.visit.list</field>
        <field name="model">crm.site.visit</field>
        <field name="arch" type="xml">
            <list string="Site Visits" default_order="date_booked desc, id desc"
                  decoration-danger="is_overdue"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'rescheduled'"
                  decoration-info="state == 'open'"
                  decoration-muted="state == 'cancelled'"
                  sample="1">
                <field name="is_overdue" column_invisible="True"/>
                <field name="name" string="Ref"/>
                <field name="lead_id" string="Lead / Opportunity"/>
                <field name="partner_id" string="Customer"/>
                <field name="city" string="Area / City" optional="show"/>
                <field name="address" string="Site Address" optional="show"/>
                <field name="date_booked" string="Date Booked"/>
                <field name="user_ids" string="Persons Going" widget="many2many_avatar_user"/>
                <field name="user_id" column_invisible="True"/>
                <field name="reschedule_count" string="Reschedules" optional="show"/>
                <field name="is_overdue" string="Overdue" widget="badge"
                       decoration-danger="is_overdue"
                       decoration-muted="not is_overdue"
                       optional="show"/>
                <field name="state" string="Status" widget="badge"
                       decoration-danger="is_overdue"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'rescheduled'"
                       decoration-info="state == 'open'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="people_seen_count" string="Persons Seen" optional="show"/>
                <field name="actual_visitor_ids" string="Actual Visitors" widget="many2many_avatar_user" optional="hide"/>
                <field name="actual_visitor_id" column_invisible="True"/>
                <field name="date_visited" string="Date Visited" optional="hide"/>
                <field name="create_date" string="Created On" optional="hide"/>
                <field name="write_date" string="Updated On" optional="hide"/>
                <button name="action_mark_done" type="object" string="Mark Done" class="btn-success btn-sm" invisible="state in ('done', 'cancelled')"/>
                <button name="action_open_reschedule_wizard" type="object" string="Reschedule" class="btn-warning btn-sm" invisible="state in ('done', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Site Visit Form View -->
    <record id="view_crm_site_visit_form" model="ir.ui.view">
        <field name="name">crm.site.visit.form</field>
        <field name="model">crm.site.visit</field>
        <field name="arch" type="xml">
            <form string="Site Visit">
                <header>
                    <button name="action_mark_done" type="object" string="Mark as Visited / Done" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_open_reschedule_wizard" type="object" string="Reschedule" class="btn-secondary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_set_open" type="object" string="Reopen Visit" class="btn-secondary" invisible="state in ('open', 'rescheduled')"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,rescheduled,done"/>
                </header>
                <sheet>
                    <field name="is_overdue" invisible="True"/>
                    <div class="alert alert-danger mb-3" role="alert" invisible="not is_overdue">
                        <i class="fa fa-exclamation-triangle me-2" title="Overdue Warning"/> <strong>Overdue Warning:</strong> The scheduled deadline for this site visit has passed. Please complete the visit or reschedule it.
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Site Visit Reference</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Booking &amp; Location">
                            <field name="lead_id" string="Lead / Opportunity" options="{'no_create': True}" required="not context.get('default_lead_id')"/>
                            <field name="partner_id" string="Customer / Company"/>
                            <field name="date_booked" string="Date Booked"/>
                            <field name="original_date" string="Original Booking Date" invisible="not original_date or original_date == date_booked"/>
                            <field name="user_ids" string="Persons Going" widget="many2many_avatar_user" placeholder="Select representatives going..."/>
                            <field name="user_id" invisible="True"/>
                            <field name="city" string="Area / City" placeholder="e.g. Domboshava, Norton, Kuwadzana..."/>
                            <field name="address" string="Site Address" placeholder="Street, suburb, town, landmarks..."/>
                        </group>

                        <group string="Rescheduling &amp; Execution Tracking">
                            <field name="reschedule_count" string="Reschedule Count"/>
                            <field name="reschedule_reason" string="Last Reschedule Reason" invisible="reschedule_count == 0"/>
                            <field name="actual_visitor_ids" string="Persons Who Went" widget="many2many_avatar_user" placeholder="Select representatives who went..."/>
                            <field name="actual_visitor_id" invisible="True"/>
                            <field name="date_visited" string="Date Visited"/>
                            <field name="people_seen_count" string="Number of Persons Seen"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Visit Notes &amp; Outcome" name="visit_notes">
                            <field name="notes" placeholder="Enter brief notes about what was discussed, site measurements, who was present, next steps..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Site Visit Calendar View -->
    <record id="view_crm_site_visit_calendar" model="ir.ui.view">
        <field name="name">crm.site.visit.calendar</field>
        <field name="model">crm.site.visit</field>
        <field name="arch" type="xml">
            <calendar string="Site Visits" date_start="date_booked" color="user_id" mode="month">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="user_id"/>
                <field name="city"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Site Visit Search / Filter View with Comprehensive Filters & Group By -->
    <record id="view_crm_site_visit_search" model="ir.ui.view">
        <field name="name">crm.site.visit.search</field>
        <field name="model">crm.site.visit</field>
        <field name="arch" type="xml">
            <search string="Search Site Visits">
                <field name="name" string="Ref"/>
                <field name="lead_id" string="Lead / Opportunity"/>
                <field name="partner_id" string="Customer"/>
                <field name="city" string="Area / City"/>
                <field name="address" string="Site Address"/>
                <field name="user_ids" string="Persons Going"/>
                <field name="user_id" string="Lead Person Going"/>
                <field name="actual_visitor_ids" string="Persons Who Went"/>
                <field name="reschedule_reason" string="Reschedule Reason"/>

                <separator/>
                <!-- Scheduling & Timeline Filters -->
                <filter string="To Be Done Today" name="filter_scheduled_today"
                        domain="[('state', 'in', ['open', 'rescheduled']),
                                 ('date_booked', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('date_booked', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="In Future / Upcoming" name="filter_future"
                        domain="[('state', 'in', ['open', 'rescheduled']),
                                 ('date_booked', '&gt;', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="To Be Done Tomorrow" name="filter_tomorrow"
                        domain="[('state', 'in', ['open', 'rescheduled']),
                                 ('date_booked', '&gt;=', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')),
                                 ('date_booked', '&lt;=', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="To Be Done This Week" name="filter_this_week"
                        domain="[('state', 'in', ['open', 'rescheduled']),
                                 ('date_booked', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d 00:00:00')),
                                 ('date_booked', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Overdue / Surpassed Deadline" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>

                <separator/>
                <!-- Status & Rescheduling Filters -->
                <filter string="Open / Scheduled" name="filter_open" domain="[('state', 'in', ['open', 'rescheduled'])]"/>
                <filter string="Rescheduled" name="filter_rescheduled" domain="[('state', '=', 'rescheduled')]"/>
                <filter string="Has Reschedules (&gt; 0)" name="filter_has_reschedules" domain="[('reschedule_count', '&gt;', 0)]"/>
                <filter string="Never Rescheduled" name="filter_never_rescheduled" domain="[('reschedule_count', '=', 0)]"/>
                <filter string="Visited / Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <!-- Assignment Filters -->
                <filter string="My Assigned Visits" name="filter_my_visits"
                        domain="['|', ('user_ids', 'in', [uid]), ('actual_visitor_ids', 'in', [uid])]"/>
                <filter string="My Open Visits" name="filter_my_open_visits"
                        domain="[('state', 'in', ['open', 'rescheduled']), '|', ('user_ids', 'in', [uid]), ('actual_visitor_ids', 'in', [uid])]"/>
                <filter string="Unassigned Visits" name="filter_unassigned" domain="[('user_ids', '=', False)]"/>

                <separator/>
                <!-- Creation & Update Filters -->
                <filter string="Created Today" name="filter_created_today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Created This Week" name="filter_created_this_week"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Created Last 7 Days" name="filter_created_last_7_days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Updated Today" name="filter_updated_today"
                        domain="[('write_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('write_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Updated This Week" name="filter_updated_this_week"
                        domain="[('write_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Visited Today" name="filter_visited_today"
                        domain="[('state', '=', 'done'),
                                 ('date_visited', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('date_visited', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>

                <separator/>
                <!-- Date Period Picker Filters -->
                <filter string="Date Booked" name="filter_date_booked" date="date_booked"/>
                <filter string="Created On" name="filter_create_date" date="create_date"/>
                <filter string="Updated On" name="filter_write_date" date="write_date"/>
                <filter string="Date Visited" name="filter_date_visited" date="date_visited"/>

                <!-- Comprehensive Group By Options -->
                <group name="group_by">
                    <filter string="Person Going (Primary Rep)" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Actual Visitor Who Went" name="group_by_actual_visitor" context="{'group_by': 'actual_visitor_id'}"/>
                    <filter string="Customer / Company" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Lead / Opportunity" name="group_by_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Area / Address / City" name="group_by_city" context="{'group_by': 'city'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Overdue Status" name="group_by_is_overdue" context="{'group_by': 'is_overdue'}"/>
                    <filter string="Reschedules Count" name="group_by_reschedules" context="{'group_by': 'reschedule_count'}"/>
                    <separator/>
                    <filter string="Date Booked: Day" name="group_by_date_day" context="{'group_by': 'date_booked:day'}"/>
                    <filter string="Date Booked: Week" name="group_by_date_week" context="{'group_by': 'date_booked:week'}"/>
                    <filter string="Date Booked: Month" name="group_by_date_month" context="{'group_by': 'date_booked:month'}"/>
                    <separator/>
                    <filter string="Created On: Day" name="group_by_create_day" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Created On: Month" name="group_by_create_month" context="{'group_by': 'create_date:month'}"/>
                    <separator/>
                    <filter string="Updated On: Day" name="group_by_write_day" context="{'group_by': 'write_date:day'}"/>
                    <filter string="Updated On: Month" name="group_by_write_month" context="{'group_by': 'write_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Site Visits Action -->
    <record id="action_crm_site_visit" model="ir.actions.act_window">
        <field name="name">Site Visits</field>
        <field name="res_model">crm.site.visit</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Book your first Site Visit!
            </p>
            <p>
                Schedule visits, track reps dispatched to client sites, manage reschedules, and record visit outcomes.
            </p>
        </field>
    </record>

    <!-- Top-Level Menu under CRM -->
    <menuitem id="menu_crm_site_visit"
              name="Site Visits"
              parent="crm.crm_menu_root"
              action="action_crm_site_visit"
              sequence="6"/>

</odoo>
