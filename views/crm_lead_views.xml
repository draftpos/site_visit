<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lead Form View Inheritance for Site Visits -->
    <record id="crm_lead_view_form_inherit_site_visit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.site.visit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <!-- Site Visits Stat Button -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_site_visits" type="object" class="oe_stat_button" icon="fa-map-marker">
                    <field name="site_visit_count" widget="statinfo" string="Site Visits"/>
                </button>
            </xpath>

            <!-- Site Visits Notebook Tab placed cleanly in main notebook -->
            <xpath expr="//notebook[1]" position="inside">
                <page string="Site Visits" name="site_visits">
                    <field name="site_visit_ids" context="{'default_lead_id': id, 'default_partner_id': partner_id, 'default_address': street}">
                        <list decoration-danger="is_overdue"
                              decoration-success="state == 'done'"
                              decoration-warning="state == 'rescheduled'"
                              decoration-info="state == 'open'"
                              decoration-muted="state == 'cancelled'">
                            <field name="is_overdue" column_invisible="True"/>
                            <field name="name" string="Ref"/>
                            <field name="user_ids" string="Persons Going" widget="many2many_avatar_user"/>
                            <field name="user_id" column_invisible="True"/>
                            <field name="address" string="Site Address"/>
                            <field name="reschedule_count" string="Reschedules"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-danger="is_overdue"
                                   decoration-success="state == 'done'"
                                   decoration-warning="state == 'rescheduled'"
                                   decoration-info="state == 'open'"
                                   decoration-muted="state == 'cancelled'"/>
                            <field name="people_seen_count" string="Persons Seen" optional="show"/>
                            <field name="actual_visitor_id" string="Actual Visitor" optional="hide"/>
                            <field name="date_visited" string="Date Visited" optional="hide"/>
                            <button name="action_mark_done" type="object" string="Mark Done" class="btn-success btn-sm" invisible="state in ('done', 'cancelled')"/>
                            <button name="action_open_reschedule_wizard" type="object" string="Reschedule" class="btn-warning btn-sm" invisible="state in ('done', 'cancelled')"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Lead Tree View Inheritance for Site Visit Status Badge -->
    <record id="crm_lead_view_tree_inherit_site_visit" model="ir.ui.view">
        <field name="name">crm.lead.tree.inherit.site.visit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="site_visit_state" string="Site Visit" widget="badge"
                       decoration-danger="site_visit_state == 'overdue'"
                       decoration-success="site_visit_state == 'done'"
                       decoration-warning="site_visit_state == 'rescheduled'"
                       decoration-info="site_visit_state == 'open'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
